<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>title</key>
	<string>IOS 云控基座</string>
	<key>items</key>
	<array>
		<dict>
			<key>cell</key>
			<string>PSGroupCell</string>
			<key>label</key>
			<string>服务</string>
			<key>footerText</key>
			<string>端口固定 5901。电脑登录后把配对码填在这里，只需一次。</string>
		</dict>
		<dict>
			<key>cell</key>
			<string>PSSwitchCell</string>
			<key>defaults</key>
			<string>com.82flex.trollvnc</string>
			<key>key</key>
			<string>Enabled</string>
			<key>label</key>
			<string>开启服务</string>
			<key>default</key>
			<true/>
		</dict>
		<dict>
			<key>cell</key>
			<string>PSEditTextCell</string>
			<key>defaults</key>
			<string>com.82flex.trollvnc</string>
			<key>key</key>
			<string>PairCode</string>
			<key>label</key>
			<string>配对码</string>
			<key>placeholder</key>
			<string>电脑上显示的 6 位数字</string>
			<key>isNumeric</key>
			<true/>
			<key>noAutoCorrect</key>
			<true/>
		</dict>
		<dict>
			<key>cell</key>
			<string>PSGroupCell</string>
			<key>label</key>
			<string>画面比例</string>
			<key>footerText</key>
			<string>画面比例越低、帧率越低，本程序占用越少。</string>
		</dict>
		<dict>
			<key>cellClass</key>
			<string>TVNCSliderCell</string>
			<key>defaults</key>
			<string>com.82flex.trollvnc</string>
			<key>key</key>
			<string>Scale</string>
			<key>default</key>
			<real>1.0</real>
			<key>min</key>
			<real>0.1</real>
			<key>max</key>
			<real>1.0</real>
			<key>showValue</key>
			<true/>
			<key>format</key>
			<string>%.2f</string>
		</dict>
		<dict>
			<key>cell</key>
			<string>PSEditTextCell</string>
			<key>defaults</key>
			<string>com.82flex.trollvnc</string>
			<key>key</key>
			<string>FrameRateSpec</string>
			<key>label</key>
			<string>帧率</string>
			<key>placeholder</key>
			<string>例如 60 或 30-60</string>
			<key>noAutoCorrect</key>
			<true/>
		</dict>
		<dict>
			<key>cell</key>
			<string>PSGroupCell</string>
			<key>footerText</key>
			<string>只统计本程序占用的内存，不是整台手机。</string>
		</dict>
		<dict>
			<key>cell</key>
			<string>PSTitleValueCell</string>
			<key>defaults</key>
			<string>com.82flex.trollvnc</string>
			<key>key</key>
			<string>MemoryUsage</string>
			<key>id</key>
			<string>MemoryUsage</string>
			<key>label</key>
			<string>内存</string>
			<key>default</key>
			<string>--</string>
		</dict>
	</array>
</dict>
</plist>
